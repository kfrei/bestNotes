rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: user_profiles
// Document ID: {userId} (must match authenticated user's UID and data.uid)
// Fields:
//   - uid: string (required, 1..128 chars, immutable, matches {userId}) - authenticated user identifier
//   - email: string (required, 1..320 chars) - user account email address
//   - displayName: string (required, 0..256 chars) - user display or full name
//   - photoURL: string (optional, 0..2048 chars) - user avatar image URL
//   - createdAt: string (required, 1..100 chars) - ISO timestamp when account was registered
//   - lastSeenAt: string (required, 1..100 chars) - ISO timestamp of user's last app session
//   - notebooksCount: number (required, >= 0) - total number of notebooks owned
//   - totalSizeBytes: number (required, >= 0) - total storage occupied in bytes
//   - totalActiveSeconds: number (required, >= 0) - cumulative active usage time in seconds
//   - activeDaysCount: number (required, >= 0) - count of distinct active usage days
//   - avgDailyMinutes: number (required, >= 0) - calculated average active usage in minutes/day
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of profile metric update
//   - planId: string (optional, 1..64 chars, admin-writable only; non-admin create may omit or set 'free') - assigned subscription plan ID
//   - aiDayKey: string (optional, 0..16 chars) - current daily AI quota window key (YYYY-MM-DD)
//   - aiDayCount: int (optional, 0..1000000) - AI calls consumed in current day window
//   - aiWeekKey: string (optional, 0..16 chars) - current weekly AI quota window key (YYYY-Www)
//   - aiWeekCount: int (optional, 0..1000000) - AI calls consumed in current week window
//   - aiTotalCount: int (optional, 0..100000000) - lifetime AI calls consumed
//
// Collection: app_plans
// Document ID: {planId} (must match data.id, immutable; 'free', 'plus', 'ultra' cannot be deleted)
// Fields:
//   - id: string (required, 1..64 chars, immutable, matches {planId}) - unique plan identifier
//   - name: string (required, 1..80 chars) - display name of the plan
//   - description: string (required, 0..500 chars) - plan summary text
//   - badgeColor: string (required, 1..40 chars) - UI badge color string
//   - order: int (required, -1000..100000) - display sort order
//   - isBuiltIn: bool (required) - whether plan is a built-in tier
//   - isUnlimited: bool (required) - whether plan bypasses quota limits
//   - maxFiles: int (required, -1..100000) - max files limit (-1 for unlimited)
//   - maxPagesPerNativeFile: int (required, -1..100000) - max pages per native file (-1 for unlimited)
//   - maxStorageMb: int (required, -1..1000000) - max storage in MB (-1 for unlimited)
//   - aiCallsPerDay: int (required, -1..100000) - daily AI call quota (-1 for unlimited)
//   - aiCallsPerWeek: int (required, -1..1000000) - weekly AI call quota (-1 for unlimited)
//   - allowAutoTags: bool (required) - whether AI auto-tagging is enabled
//   - updatedAt: string (required, 1..64 chars) - ISO timestamp of last plan update
//
// Collection: users
// Document ID: {userId} (must match authenticated user's UID)
// Fields:
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last sync
//   - customFoldersJson: string (optional, 0..1000000 chars) - serialized custom folders JSON
//   - foldersUpdatedAt: string (optional, 0..100 chars) - ISO timestamp of last custom folders edit
//   - shapeLibraryJson: string (optional, 0..1000000 chars) - serialized shape library JSON
//   - deviceId: string (optional, 0..256 chars) - originating client device identifier
//   - geminiApiKey: string (optional, 0..512 chars) - user-configured Gemini API key
//   - driveEmail: string (optional, 0..320 chars) - linked Google Drive account email
//   - driveAccessTokenV2: string (optional, 0..4096 chars) - legacy V2 Google Drive OAuth access token
//   - driveTokenIssuedAt: number (optional, >= 0) - epoch timestamp when V2 Drive token was issued
//   - driveAccessTokenV3: string (optional, 0..4096 chars) - V3 Google Drive OAuth access token
//   - driveTokenIssuedAtV3: number (optional, >= 0) - epoch timestamp when V3 Drive token was issued
//   - driveOfflineLinked: bool (optional) - whether server-side offline refresh token is linked
//   - driveBasePath: string (optional, 0..512 chars) - configured Google Drive sync folder path
//
// Collection: drivePrivateTokens
// Document ID: {userId} (server-only, managed exclusively via Firebase Admin SDK in Cloud Functions)
// Fields:
//   - Server-managed Google Drive OAuth2 offline refresh token metadata (no client read/write access)
//
// Subcollection: users/{userId}/notebooks
// Document ID: {notebookId} (must match data.id, immutable)
// Fields:
//   - id: string (required, 1..256 chars, immutable) - unique notebook identifier matching {notebookId}
//   - title: string (required, 0..1000 chars) - notebook display title
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last modification
//   - dataJson: string (optional, 0..1000000 chars) - serialized notebook content JSON
//   - deleted: bool (optional) - soft-deletion tombstone flag
//   - deviceId: string (optional, 0..256 chars) - originating client device identifier
//
// Collection: app_config
// Document ID: gemini
// Fields:
//   - geminiApiKey: string (required, 0..512 chars) - application-level Gemini API key
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last configuration update
//
// Collection: live_rooms
// Document ID: {roomId} (must match data.roomId, immutable)
// Fields:
//   - roomId: string (required, 1..32 chars, immutable) - 4-digit PIN or room identifier matching {roomId}
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last room state update
//   - senderId: string (optional, 0..128 chars) - sender client identifier
//   - receiverId: string (optional, 0..128 chars) - receiver client identifier
//   - rtcOfferJson: string (optional, 0..65536 chars) - serialized WebRTC SDP offer JSON
//   - rtcAnswerJson: string (optional, 0..65536 chars) - serialized WebRTC SDP answer JSON
//   - senderCandidatesJson: string (optional, 0..65536 chars) - serialized sender ICE candidates JSON
//   - receiverCandidatesJson: string (optional, 0..65536 chars) - serialized receiver ICE candidates JSON
//   - viewportJson: string (optional, 0..4096 chars) - serialized 16:9 viewport state JSON
//   - liveInkJson: string (optional, 0..100000 chars) - serialized live ink strokes JSON
//   - pageJson: string (optional, 0..950000 chars) - serialized page content JSON
//   - simStateJson: string (optional, 0..65536 chars) - serialized simulation state JSON
//
// Collection: daily_traffic
// Document ID: {dateId} (ISO date string YYYY-MM-DD matching data.date)
// Fields:
//   - date: string (required, 10 chars, immutable matching {dateId}) - ISO date string (YYYY-MM-DD)
//   - totalVisits: number (optional, >= 0) - total visits count
//   - guestVisits: number (optional, >= 0) - visits by guest/unauthenticated users
//   - registeredVisits: number (optional, >= 0) - visits by registered users
//   - guestFilesCreated: number (optional, >= 0) - files created by guest users
//   - registeredFilesCreated: number (optional, >= 0) - files created by registered users
//   - totalFilesCreated: number (optional, >= 0) - total files created count
//   - totalActiveSeconds: number (optional, >= 0) - cumulative active seconds across users
//   - uniqueVisitorsEstimate: number (optional, >= 0) - estimated unique visitor count
//   - ocrTextCount: number (optional, >= 0) - handwriting Greek text OCR calls
//   - ocrMathCount: number (optional, >= 0) - math & equation / LaTeX OCR calls
//   - ocrChemCount: number (optional, >= 0) - chemistry & molecule OCR calls
//   - ocrAnimCount: number (optional, >= 0) - Smart Sketch Animation / Ζωντάνεμα AI calls
//   - ocrAdminCount: number (optional, >= 0) - AI requests initiated by the Admin
//   - ocrOtherUsersCount: number (optional, >= 0) - AI requests initiated by other registered users
//   - ocrGuestCount: number (optional, >= 0) - AI requests initiated by guest visitors
//   - ocrTotalCount: number (optional, >= 0) - total AI OCR calls count
//   - ocrApi1Count: number (optional, >= 0) - AI requests routed through Gemini API key slot 1
//   - ocrApi2Count: number (optional, >= 0) - AI requests routed through Gemini API key slot 2
//   - ocrCustomKeyCount: number (optional, >= 0) - AI requests routed through a user-configured custom Gemini API key
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of metric update
//
// Collection: public_showcase_meta
// Document ID: config (single config document; must match data.id, immutable)
// Fields:
//   - id: string (required, 1..64 chars, immutable, matches {docId} == 'config') - config document identifier
//   - folderName: string (required, 1..200 chars) - public demo folder display name
//   - folderColor: string (optional, 0..40 chars) - public demo folder UI color
//   - folderIcon: string (optional, 0..64 chars) - public demo folder UI icon identifier
//   - seeded: bool (required) - whether initial showcase notebooks have been seeded
//   - seededAt: string (optional, 0..100 chars) - ISO timestamp of initial seeding
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last metadata update
//   - deviceId: string (optional, 0..256 chars) - originating admin device identifier
//
// Collection: public_showcase_notebooks
// Document ID: {notebookId} (primary 'showcase-...' docs and chunked 'showcase-...__chunk_{n}' docs; must match data.id, immutable)
// Fields:
//   - id: string (required, 1..256 chars, immutable) - unique notebook or chunk identifier matching {notebookId}
//   - title: string (required, 0..1000 chars) - notebook display title (or '__CHUNK__' for chunk docs)
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last modification
//   - dataJson: string (optional, 0..1000000 chars) - serialized notebook content, manifest, or chunk JSON
//   - deleted: bool (optional) - soft-deletion tombstone flag
//   - deviceId: string (optional, 0..256 chars) - originating admin device identifier
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents and subcollections)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is the bootstrapped administrator
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'freiderikoskostas@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Validate required fields exist on the resulting document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate required string field type and length bounds
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string field (if present, must be string and within length bounds)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate optional boolean field (if present, must be bool)
    function isValidOptionalBool(field) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is bool);
    }

    // Validate required number field (must be number and non-negative)
    function isValidNumber(field) {
      return request.resource.data[field] is number &&
        request.resource.data[field] >= 0;
    }

    // Validate optional number field (if present, must be number and non-negative)
    function isValidOptionalNumber(field) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= 0);
    }

    // Validate required integer field within inclusive [minVal, maxVal] bounds
    function isValidIntRange(field, minVal, maxVal) {
      return request.resource.data[field] is int &&
        request.resource.data[field] >= minVal &&
        request.resource.data[field] <= maxVal;
    }

    // Validate optional integer field within inclusive [minVal, maxVal] bounds
    function isValidOptionalIntRange(field, minVal, maxVal) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is int &&
         request.resource.data[field] >= minVal &&
         request.resource.data[field] <= maxVal);
    }

    // Validate that immutable fields have not been modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidSubscriptionPlan(data, planId) {
      return hasOnlyAllowedFields([
          'id',
          'name',
          'description',
          'badgeColor',
          'order',
          'isBuiltIn',
          'isUnlimited',
          'maxFiles',
          'maxPagesPerNativeFile',
          'maxStorageMb',
          'aiCallsPerDay',
          'aiCallsPerWeek',
          'allowAutoTags',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'id',
          'name',
          'description',
          'badgeColor',
          'order',
          'isBuiltIn',
          'isUnlimited',
          'maxFiles',
          'maxPagesPerNativeFile',
          'maxStorageMb',
          'aiCallsPerDay',
          'aiCallsPerWeek',
          'allowAutoTags',
          'updatedAt'
        ]) &&
        data.id == planId &&
        validStringLength('id', 1, 64) &&
        validStringLength('name', 1, 80) &&
        validStringLength('description', 0, 500) &&
        validStringLength('badgeColor', 1, 40) &&
        isValidIntRange('order', -1000, 100000) &&
        data.isBuiltIn is bool &&
        data.isUnlimited is bool &&
        isValidIntRange('maxFiles', -1, 100000) &&
        isValidIntRange('maxPagesPerNativeFile', -1, 100000) &&
        isValidIntRange('maxStorageMb', -1, 1000000) &&
        isValidIntRange('aiCallsPerDay', -1, 100000) &&
        isValidIntRange('aiCallsPerWeek', -1, 1000000) &&
        data.allowAutoTags is bool &&
        validStringLength('updatedAt', 1, 64);
    }

    function isValidUserProfile(data, userId) {
      return hasOnlyAllowedFields([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'lastSeenAt',
          'notebooksCount',
          'totalSizeBytes',
          'totalActiveSeconds',
          'activeDaysCount',
          'avgDailyMinutes',
          'updatedAt',
          'planId',
          'aiDayKey',
          'aiDayCount',
          'aiWeekKey',
          'aiWeekCount',
          'aiTotalCount'
        ]) &&
        hasRequiredFields([
          'uid',
          'email',
          'displayName',
          'createdAt',
          'lastSeenAt',
          'notebooksCount',
          'totalSizeBytes',
          'totalActiveSeconds',
          'activeDaysCount',
          'avgDailyMinutes',
          'updatedAt'
        ]) &&
        data.uid == userId &&
        validStringLength('uid', 1, 128) &&
        validStringLength('email', 1, 320) &&
        validStringLength('displayName', 0, 256) &&
        isValidOptionalString('photoURL', 0, 2048) &&
        validStringLength('createdAt', 1, 100) &&
        validStringLength('lastSeenAt', 1, 100) &&
        isValidNumber('notebooksCount') &&
        isValidNumber('totalSizeBytes') &&
        isValidNumber('totalActiveSeconds') &&
        isValidNumber('activeDaysCount') &&
        isValidNumber('avgDailyMinutes') &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('planId', 1, 64) &&
        isValidOptionalString('aiDayKey', 0, 16) &&
        isValidOptionalIntRange('aiDayCount', 0, 1000000) &&
        isValidOptionalString('aiWeekKey', 0, 16) &&
        isValidOptionalIntRange('aiWeekCount', 0, 1000000) &&
        isValidOptionalIntRange('aiTotalCount', 0, 100000000);
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly([
          'customFoldersJson',
          'foldersUpdatedAt',
          'shapeLibraryJson',
          'updatedAt',
          'deviceId',
          'geminiApiKey',
          'driveEmail',
          'driveAccessTokenV2',
          'driveTokenIssuedAt',
          'driveAccessTokenV3',
          'driveTokenIssuedAtV3',
          'driveOfflineLinked',
          'driveBasePath'
        ]) &&
        hasRequiredFields(['updatedAt']) &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('customFoldersJson', 0, 1000000) &&
        isValidOptionalString('foldersUpdatedAt', 0, 100) &&
        isValidOptionalString('shapeLibraryJson', 0, 1000000) &&
        isValidOptionalString('deviceId', 0, 256) &&
        isValidOptionalString('geminiApiKey', 0, 512) &&
        isValidOptionalString('driveEmail', 0, 320) &&
        isValidOptionalString('driveAccessTokenV2', 0, 4096) &&
        isValidOptionalNumber('driveTokenIssuedAt') &&
        isValidOptionalString('driveAccessTokenV3', 0, 4096) &&
        isValidOptionalNumber('driveTokenIssuedAtV3') &&
        isValidOptionalBool('driveOfflineLinked') &&
        isValidOptionalString('driveBasePath', 0, 512);
    }

    function isValidNotebookDoc(data, notebookId) {
      return data.keys().hasOnly(['id', 'title', 'updatedAt', 'dataJson', 'deleted', 'deviceId']) &&
        hasRequiredFields(['id', 'title', 'updatedAt']) &&
        validStringLength('id', 1, 256) &&
        data.id == notebookId &&
        validStringLength('title', 0, 1000) &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('dataJson', 0, 1000000) &&
        isValidOptionalBool('deleted') &&
        isValidOptionalString('deviceId', 0, 256);
    }

    function isValidAppConfigGemini(data) {
      return data.keys().hasOnly(['geminiApiKey', 'updatedAt']) &&
        data.keys().hasAll(['geminiApiKey', 'updatedAt']) &&
        validStringLength('geminiApiKey', 0, 512) &&
        validStringLength('updatedAt', 1, 100);
    }

    function isValidLiveRoomDoc(data, roomId) {
      return hasOnlyAllowedFields([
          'roomId',
          'updatedAt',
          'senderId',
          'receiverId',
          'rtcOfferJson',
          'rtcAnswerJson',
          'senderCandidatesJson',
          'receiverCandidatesJson',
          'viewportJson',
          'liveInkJson',
          'pageJson',
          'simStateJson'
        ]) &&
        hasRequiredFields(['roomId', 'updatedAt']) &&
        validStringLength('roomId', 1, 32) &&
        data.roomId == roomId &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('senderId', 0, 128) &&
        isValidOptionalString('receiverId', 0, 128) &&
        isValidOptionalString('rtcOfferJson', 0, 65536) &&
        isValidOptionalString('rtcAnswerJson', 0, 65536) &&
        isValidOptionalString('senderCandidatesJson', 0, 65536) &&
        isValidOptionalString('receiverCandidatesJson', 0, 65536) &&
        isValidOptionalString('viewportJson', 0, 4096) &&
        isValidOptionalString('liveInkJson', 0, 100000) &&
        isValidOptionalString('pageJson', 0, 950000) &&
        isValidOptionalString('simStateJson', 0, 65536);
    }

    function isValidDailyTrafficDoc(data, dateId) {
      return hasOnlyAllowedFields([
          'date',
          'totalVisits',
          'guestVisits',
          'registeredVisits',
          'guestFilesCreated',
          'registeredFilesCreated',
          'totalFilesCreated',
          'totalActiveSeconds',
          'uniqueVisitorsEstimate',
          'ocrTextCount',
          'ocrMathCount',
          'ocrChemCount',
          'ocrAnimCount',
          'ocrAdminCount',
          'ocrOtherUsersCount',
          'ocrGuestCount',
          'ocrTotalCount',
          'ocrApi1Count',
          'ocrApi2Count',
          'ocrCustomKeyCount',
          'updatedAt'
        ]) &&
        hasRequiredFields(['date', 'updatedAt']) &&
        data.date == dateId &&
        validStringLength('date', 10, 10) &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalNumber('totalVisits') &&
        isValidOptionalNumber('guestVisits') &&
        isValidOptionalNumber('registeredVisits') &&
        isValidOptionalNumber('guestFilesCreated') &&
        isValidOptionalNumber('registeredFilesCreated') &&
        isValidOptionalNumber('totalFilesCreated') &&
        isValidOptionalNumber('totalActiveSeconds') &&
        isValidOptionalNumber('uniqueVisitorsEstimate') &&
        isValidOptionalNumber('ocrTextCount') &&
        isValidOptionalNumber('ocrMathCount') &&
        isValidOptionalNumber('ocrChemCount') &&
        isValidOptionalNumber('ocrAnimCount') &&
        isValidOptionalNumber('ocrAdminCount') &&
        isValidOptionalNumber('ocrOtherUsersCount') &&
        isValidOptionalNumber('ocrGuestCount') &&
        isValidOptionalNumber('ocrTotalCount') &&
        isValidOptionalNumber('ocrApi1Count') &&
        isValidOptionalNumber('ocrApi2Count') &&
        isValidOptionalNumber('ocrCustomKeyCount');
    }

    function isValidPublicShowcaseMeta(data, docId) {
      return hasOnlyAllowedFields([
          'id',
          'folderName',
          'folderColor',
          'folderIcon',
          'seeded',
          'seededAt',
          'updatedAt',
          'deviceId'
        ]) &&
        hasRequiredFields([
          'id',
          'folderName',
          'seeded',
          'updatedAt'
        ]) &&
        data.id == docId &&
        validStringLength('id', 1, 64) &&
        validStringLength('folderName', 1, 200) &&
        isValidOptionalString('folderColor', 0, 40) &&
        isValidOptionalString('folderIcon', 0, 64) &&
        data.seeded is bool &&
        isValidOptionalString('seededAt', 0, 100) &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('deviceId', 0, 256);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /app_plans/{planId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSubscriptionPlan(request.resource.data, planId);
      allow delete: if isAdmin() && !(planId in ['free', 'plus', 'ultra']);
    }

    match /user_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isValidUserProfile(request.resource.data, userId) && (
        isAdmin() ||
        (isOwner(userId) &&
          (!('planId' in request.resource.data) || request.resource.data.planId == 'free'))
      );
      allow update: if isValidUserProfile(request.resource.data, userId) &&
        areImmutableFieldsUnchanged(['uid']) && (
        isAdmin() ||
        (isOwner(userId) && areImmutableFieldsUnchanged(['planId']))
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserDoc(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidUserDoc(request.resource.data) &&
        (!('foldersUpdatedAt' in resource.data &&
           resource.data.foldersUpdatedAt is string &&
           'foldersUpdatedAt' in request.resource.data &&
           request.resource.data.foldersUpdatedAt is string) ||
         request.resource.data.foldersUpdatedAt >= resource.data.foldersUpdatedAt);
      allow delete: if isOwner(userId);

      match /notebooks/{notebookId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidNotebookDoc(request.resource.data, notebookId);
        allow update: if isOwner(userId) &&
          isValidNotebookDoc(request.resource.data, notebookId) &&
          areImmutableFieldsUnchanged(['id']) &&
          (!('updatedAt' in resource.data &&
             resource.data.updatedAt is string &&
             request.resource.data.updatedAt is string) ||
           request.resource.data.updatedAt >= resource.data.updatedAt);
        allow delete: if isOwner(userId);
      }
    }

    match /app_config/gemini {
      allow get: if isAuthenticated();
      allow create, update: if isAdmin() && isValidAppConfigGemini(request.resource.data);
    }

    match /live_rooms/{roomId} {
      allow get: if true;
      allow create: if isValidLiveRoomDoc(request.resource.data, roomId);
      allow update: if isValidLiveRoomDoc(request.resource.data, roomId) &&
        areImmutableFieldsUnchanged(['roomId']);
      allow delete: if isAuthenticated();
    }

    match /daily_traffic/{dateId} {
      allow read: if isAdmin();
      allow create, update: if isValidDailyTrafficDoc(request.resource.data, dateId);
      allow delete: if isAdmin();
    }

    // Public Showcase / Demo Folder metadata (public read for Guests + Signed-in users, Admin-only write)
    match /public_showcase_meta/{docId} {
      allow read: if true;
      allow create: if isAdmin() &&
        docId == 'config' &&
        isValidPublicShowcaseMeta(request.resource.data, docId);
      allow update: if isAdmin() &&
        docId == 'config' &&
        isValidPublicShowcaseMeta(request.resource.data, docId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isAdmin();
    }

    // Public Showcase / Demo Folder notebooks and chunks (public read for Guests + Signed-in users, Admin-only write)
    match /public_showcase_notebooks/{notebookId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNotebookDoc(request.resource.data, notebookId);
      allow update: if isAdmin() &&
        isValidNotebookDoc(request.resource.data, notebookId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isAdmin();
    }

    // Server-only Google Drive OAuth2 offline refresh tokens (managed exclusively via Firebase Admin SDK in Cloud Functions)
    match /drivePrivateTokens/{userId} {
      allow read, write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
