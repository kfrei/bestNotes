rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: user_profiles
// Document ID: {userId} (must match authenticated user's UID and data.uid)
// Fields:
//   - uid: string (required, 1..128 chars, matches {userId}) - authenticated user identifier
//   - email: string (required, 1..320 chars) - user account email address
//   - displayName: string (required, 0..256 chars) - user display or full name
//   - photoURL: string (optional, 0..2048 chars) - user avatar image URL
//   - createdAt: string (required, 1..100 chars) - ISO timestamp when account was registered
//   - lastSeenAt: string (required, 1..100 chars) - ISO timestamp of user's last app session
//   - notebooksCount: number (required, >= 0) - total number of notebooks owned
//   - totalSizeBytes: number (required, >= 0) - total storage occupied in bytes
//   - totalActiveSeconds: number (required, >= 0) - cumulative active usage time in seconds
//   - activeDaysCount: number (required, >= 0) - count of distinct active usage days
//   - avgDailyMinutes: number (required, >= 0) - calculated average active usage in minutes/day
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of profile metric update
//
// Collection: users
// Document ID: {userId} (must match authenticated user's UID)
// Fields:
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last sync
//   - customFoldersJson: string (optional, 0..1000000 chars) - serialized custom folders JSON
//   - foldersUpdatedAt: string (optional, 0..100 chars) - ISO timestamp of last custom folders edit
//   - shapeLibraryJson: string (optional, 0..1000000 chars) - serialized shape library JSON
//   - deviceId: string (optional, 0..256 chars) - originating client device identifier
//   - geminiApiKey: string (optional, 0..512 chars) - user-configured Gemini API key
//   - driveEmail: string (optional, 0..320 chars) - linked Google Drive account email
//   - driveAccessTokenV2: string (optional, 0..4096 chars) - Google Drive OAuth access token
//   - driveTokenIssuedAt: number (optional, >= 0) - epoch timestamp when Drive token was issued
//   - driveBasePath: string (optional, 0..512 chars) - configured Google Drive sync folder path
//
// Subcollection: users/{userId}/notebooks
// Document ID: {notebookId} (must match data.id, immutable)
// Fields:
//   - id: string (required, 1..256 chars, immutable) - unique notebook identifier matching {notebookId}
//   - title: string (required, 0..1000 chars) - notebook display title
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last modification
//   - dataJson: string (optional, 0..1000000 chars) - serialized notebook content JSON
//   - deleted: bool (optional) - soft-deletion tombstone flag
//   - deviceId: string (optional, 0..256 chars) - originating client device identifier
//
// Collection: app_config
// Document ID: gemini
// Fields:
//   - geminiApiKey: string (required, 0..512 chars) - application-level Gemini API key
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last configuration update
//
// Collection: live_rooms
// Document ID: {roomId} (must match data.roomId, immutable)
// Fields:
//   - roomId: string (required, 1..32 chars, immutable) - 4-digit PIN or room identifier matching {roomId}
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of last room state update
//   - senderId: string (optional, 0..128 chars) - sender client identifier
//   - receiverId: string (optional, 0..128 chars) - receiver client identifier
//   - rtcOfferJson: string (optional, 0..65536 chars) - serialized WebRTC SDP offer JSON
//   - rtcAnswerJson: string (optional, 0..65536 chars) - serialized WebRTC SDP answer JSON
//   - senderCandidatesJson: string (optional, 0..65536 chars) - serialized sender ICE candidates JSON
//   - receiverCandidatesJson: string (optional, 0..65536 chars) - serialized receiver ICE candidates JSON
//   - viewportJson: string (optional, 0..4096 chars) - serialized 16:9 viewport state JSON
//   - liveInkJson: string (optional, 0..100000 chars) - serialized live ink strokes JSON
//   - pageJson: string (optional, 0..950000 chars) - serialized page content JSON
//   - simStateJson: string (optional, 0..65536 chars) - serialized simulation state JSON
//
// Collection: daily_traffic
// Document ID: {dateId} (ISO date string YYYY-MM-DD matching data.date)
// Fields:
//   - date: string (required, 10 chars, immutable matching {dateId}) - ISO date string (YYYY-MM-DD)
//   - totalVisits: number (optional, >= 0) - total visits count
//   - guestVisits: number (optional, >= 0) - visits by guest/unauthenticated users
//   - registeredVisits: number (optional, >= 0) - visits by registered users
//   - guestFilesCreated: number (optional, >= 0) - files created by guest users
//   - registeredFilesCreated: number (optional, >= 0) - files created by registered users
//   - totalFilesCreated: number (optional, >= 0) - total files created count
//   - totalActiveSeconds: number (optional, >= 0) - cumulative active seconds across users
//   - uniqueVisitorsEstimate: number (optional, >= 0) - estimated unique visitor count
//   - updatedAt: string (required, 1..100 chars) - ISO timestamp of metric update
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents and subcollections)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is the bootstrapped administrator
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'freiderikoskostas@gmail.com';
    }

    // Validate required fields exist on the resulting document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate required string field type and length bounds
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string field (if present, must be string and within length bounds)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate optional boolean field (if present, must be bool)
    function isValidOptionalBool(field) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is bool);
    }

    // Validate required number field (must be number and non-negative)
    function isValidNumber(field) {
      return request.resource.data[field] is number &&
        request.resource.data[field] >= 0;
    }

    // Validate optional number field (if present, must be number and non-negative)
    function isValidOptionalNumber(field) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= 0);
    }

    // Validate that immutable fields have not been modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidUserProfile(data, userId) {
      return hasOnlyAllowedFields([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'lastSeenAt',
          'notebooksCount',
          'totalSizeBytes',
          'totalActiveSeconds',
          'activeDaysCount',
          'avgDailyMinutes',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'uid',
          'email',
          'displayName',
          'createdAt',
          'lastSeenAt',
          'notebooksCount',
          'totalSizeBytes',
          'totalActiveSeconds',
          'activeDaysCount',
          'avgDailyMinutes',
          'updatedAt'
        ]) &&
        data.uid == userId &&
        validStringLength('uid', 1, 128) &&
        validStringLength('email', 1, 320) &&
        validStringLength('displayName', 0, 256) &&
        isValidOptionalString('photoURL', 0, 2048) &&
        validStringLength('createdAt', 1, 100) &&
        validStringLength('lastSeenAt', 1, 100) &&
        isValidNumber('notebooksCount') &&
        isValidNumber('totalSizeBytes') &&
        isValidNumber('totalActiveSeconds') &&
        isValidNumber('activeDaysCount') &&
        isValidNumber('avgDailyMinutes') &&
        validStringLength('updatedAt', 1, 100);
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly([
          'customFoldersJson',
          'foldersUpdatedAt',
          'shapeLibraryJson',
          'updatedAt',
          'deviceId',
          'geminiApiKey',
          'driveEmail',
          'driveAccessTokenV2',
          'driveTokenIssuedAt',
          'driveBasePath'
        ]) &&
        hasRequiredFields(['updatedAt']) &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('customFoldersJson', 0, 1000000) &&
        isValidOptionalString('foldersUpdatedAt', 0, 100) &&
        isValidOptionalString('shapeLibraryJson', 0, 1000000) &&
        isValidOptionalString('deviceId', 0, 256) &&
        isValidOptionalString('geminiApiKey', 0, 512) &&
        isValidOptionalString('driveEmail', 0, 320) &&
        isValidOptionalString('driveAccessTokenV2', 0, 4096) &&
        isValidOptionalNumber('driveTokenIssuedAt') &&
        isValidOptionalString('driveBasePath', 0, 512);
    }

    function isValidNotebookDoc(data, notebookId) {
      return data.keys().hasOnly(['id', 'title', 'updatedAt', 'dataJson', 'deleted', 'deviceId']) &&
        hasRequiredFields(['id', 'title', 'updatedAt']) &&
        validStringLength('id', 1, 256) &&
        data.id == notebookId &&
        validStringLength('title', 0, 1000) &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('dataJson', 0, 1000000) &&
        isValidOptionalBool('deleted') &&
        isValidOptionalString('deviceId', 0, 256);
    }

    function isValidLiveRoomDoc(data, roomId) {
      return hasOnlyAllowedFields([
          'roomId',
          'updatedAt',
          'senderId',
          'receiverId',
          'rtcOfferJson',
          'rtcAnswerJson',
          'senderCandidatesJson',
          'receiverCandidatesJson',
          'viewportJson',
          'liveInkJson',
          'pageJson',
          'simStateJson'
        ]) &&
        hasRequiredFields(['roomId', 'updatedAt']) &&
        validStringLength('roomId', 1, 32) &&
        data.roomId == roomId &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalString('senderId', 0, 128) &&
        isValidOptionalString('receiverId', 0, 128) &&
        isValidOptionalString('rtcOfferJson', 0, 65536) &&
        isValidOptionalString('rtcAnswerJson', 0, 65536) &&
        isValidOptionalString('senderCandidatesJson', 0, 65536) &&
        isValidOptionalString('receiverCandidatesJson', 0, 65536) &&
        isValidOptionalString('viewportJson', 0, 4096) &&
        isValidOptionalString('liveInkJson', 0, 100000) &&
        isValidOptionalString('pageJson', 0, 950000) &&
        isValidOptionalString('simStateJson', 0, 65536);
    }

    function isValidDailyTrafficDoc(data, dateId) {
      return hasOnlyAllowedFields([
          'date',
          'totalVisits',
          'guestVisits',
          'registeredVisits',
          'guestFilesCreated',
          'registeredFilesCreated',
          'totalFilesCreated',
          'totalActiveSeconds',
          'uniqueVisitorsEstimate',
          'updatedAt'
        ]) &&
        hasRequiredFields(['date', 'updatedAt']) &&
        data.date == dateId &&
        validStringLength('date', 10, 10) &&
        validStringLength('updatedAt', 1, 100) &&
        isValidOptionalNumber('totalVisits') &&
        isValidOptionalNumber('guestVisits') &&
        isValidOptionalNumber('registeredVisits') &&
        isValidOptionalNumber('guestFilesCreated') &&
        isValidOptionalNumber('registeredFilesCreated') &&
        isValidOptionalNumber('totalFilesCreated') &&
        isValidOptionalNumber('totalActiveSeconds') &&
        isValidOptionalNumber('uniqueVisitorsEstimate');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /user_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserDoc(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidUserDoc(request.resource.data) &&
        (!('foldersUpdatedAt' in resource.data &&
           resource.data.foldersUpdatedAt is string &&
           'foldersUpdatedAt' in request.resource.data &&
           request.resource.data.foldersUpdatedAt is string) ||
         request.resource.data.foldersUpdatedAt >= resource.data.foldersUpdatedAt);
      allow delete: if isOwner(userId);

      match /notebooks/{notebookId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidNotebookDoc(request.resource.data, notebookId);
        allow update: if isOwner(userId) &&
          isValidNotebookDoc(request.resource.data, notebookId) &&
          areImmutableFieldsUnchanged(['id']) &&
          (!('updatedAt' in resource.data &&
             resource.data.updatedAt is string &&
             request.resource.data.updatedAt is string) ||
           request.resource.data.updatedAt >= resource.data.updatedAt);
        allow delete: if isOwner(userId);
      }
    }

    match /app_config/gemini {
      allow get: if true;
      allow create, update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['geminiApiKey', 'updatedAt']) &&
        validStringLength('geminiApiKey', 0, 512) &&
        validStringLength('updatedAt', 1, 100);
    }

    match /live_rooms/{roomId} {
      allow read: if true;
      allow create: if isValidLiveRoomDoc(request.resource.data, roomId);
      allow update: if isValidLiveRoomDoc(request.resource.data, roomId) &&
        areImmutableFieldsUnchanged(['roomId']);
      allow delete: if true;
    }

    match /daily_traffic/{dateId} {
      allow read: if isAdmin();
      allow create, update: if isValidDailyTrafficDoc(request.resource.data, dateId);
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
